<!-- Ajustes: siguen la mirada abajo a la izquierda. Altura de la fabrica, volumenes
     independientes de musica y efectos, y recalibrar con la mano. -->
<style>
  .root { flex-direction: column; width: 300px; }
  .content { flex-direction: column; gap: 8px; padding: 14px; }
  .toggle { padding-top: 8px; padding-bottom: 8px; padding-left: 14px; padding-right: 14px; border-radius: 14px;
    background-color: #fff6e6; color: #5f4c45; font-size: 17px; font-weight: 700; text-align: center; cursor: pointer; }
  .body { flex-direction: column; gap: 8px; }
  .row { flex-direction: row; gap: 8px; align-items: center; justify-content: space-between; }
  .label { color: #e9dfcf; font-size: 15px; font-weight: 700; width: 90px; }
  .chip { width: 44px; height: 36px; border-radius: 12px; background-color: #fff6e6; color: #5f4c45;
    font-size: 20px; font-weight: 700; text-align: center; padding-top: 5px; cursor: pointer; }
  .value { color: #fff6e6; font-size: 16px; font-weight: 700; width: 56px; text-align: center; }
  .recal { padding-top: 9px; padding-bottom: 9px; padding-left: 12px; padding-right: 12px; border-radius: 14px;
    background-color: #f9c623; color: #5f4c45; font-size: 15px; font-weight: 700; text-align: center; cursor: pointer; }
</style>
<Panel class="root">
  <div class="content">
    <div id="toggle" class="toggle">Ajustes</div>
    <div id="body" class="body">
      <div class="row"><div class="label">Altura</div><div id="h-minus" class="chip">-</div><div id="h-out" class="value">0</div><div id="h-plus" class="chip">+</div></div>
      <div class="row"><div class="label">Musica</div><div id="m-minus" class="chip">-</div><div id="m-out" class="value">0</div><div id="m-plus" class="chip">+</div></div>
      <div class="row"><div class="label">Efectos</div><div id="e-minus" class="chip">-</div><div id="e-out" class="value">0</div><div id="e-plus" class="chip">+</div></div>
      <div id="recal" class="recal">Recalibrar con la mano</div>
    </div>
  </div>
</Panel>
