<!-- Editor de la tarjeta Amiibo: nombre (con el teclado), cumpleanos y fondo. La tarjeta se ve a su lado
     (src/checkout/card-view.js). -->
<style>
  @font-face { font-family: Nunito; font-weight: 400; src: url(../fonts/Nunito_400Regular.ttf); }
  @font-face { font-family: Nunito; font-weight: 700; src: url(../fonts/Nunito_700Bold.ttf); }
  .root { flex-direction: column; width: 520px; font-family: Nunito; background-color: #FAF6D4; border-radius: 28px; border-width: 4px; border-color: #FDD885; }
  .content { flex-direction: column; gap: 10px; padding: 24px; }
  .title { color: #3A2E28; font-size: 32px; font-weight: 700; }
  .text { color: #6B5C52; font-size: 16px; line-height: 1.25; }
  .label { color: #5E4D47; font-size: 15px; font-weight: 700; letter-spacing: 1.2px; }
  .row { flex-direction: row; gap: 8px; align-items: center; }
  .chip { padding-top: 8px; padding-bottom: 8px; padding-left: 14px; padding-right: 14px; border-radius: 20px; background-color: #FFFBF2; color: #3A2E28;
    font-size: 16px; font-weight: 700; text-align: center; cursor: pointer; border-width: 3px; border-color: #FDD885; }
  .field { flex-grow: 1; padding-top: 10px; padding-bottom: 10px; padding-left: 14px; padding-right: 14px; border-radius: 14px; background-color: #FFFBF2; color: #3A2E28;
    font-size: 22px; font-weight: 700; border-width: 3px; border-color: #FDD885; cursor: pointer; }
  .value { color: #3A2E28; font-size: 19px; font-weight: 700; min-width: 120px; text-align: center; }
  .small { color: #8B806F; font-size: 13px; line-height: 1.25; }
  .ready { color: #2F5D46; font-size: 21px; font-weight: 700; }
  .btn { flex-grow: 1; padding-top: 12px; padding-bottom: 12px; padding-left: 18px; padding-right: 18px; border-radius: 40px; background-color: #FFFBF2; color: #E60012;
    font-size: 20px; font-weight: 700; text-align: center; cursor: pointer; border-width: 4px; border-color: #FF0000; }
  .primary { background-color: #FF0000; color: #ffffff; }
</style>
<div class="root">
  <div class="content">
    <div class="title">Crea tu tarjeta Amiibo</div>
    <div class="text">Se genero a partir de tu avatar. Ajusta sus datos y el fondo: la tarjeta cambia al instante.</div>
    <div class="label">NOMBRE (toca para escribir)</div>
    <div class="row"><div id="f-cardName" class="field">-</div></div>
    <div class="label">CUMPLEANOS</div>
    <div class="row">
      <div id="d-minus" class="chip">-</div><div id="d-day" class="value">-</div><div id="d-plus" class="chip">+</div>
      <div id="mo-prev" class="chip">-</div><div id="mo-name" class="value">-</div><div id="mo-next" class="chip">-</div>
    </div>
    <div class="label">FONDO</div>
    <div class="row">
      <div id="th-0" class="chip">-</div><div id="th-1" class="chip">-</div><div id="th-2" class="chip">-</div>
      <div id="th-3" class="chip">-</div><div id="th-4" class="chip">-</div>
    </div>
    <div class="ready">Tu tarjeta esta lista!</div>
    <div class="row">
      <div id="share" class="btn primary">Compartir</div>
      <div id="finish" class="btn">Finalizar</div>
    </div>
    <div class="row"><div id="back" class="btn">Volver a mi avatar</div></div>
    <div class="small">Tarjeta digital conceptual inspirada en el formato de las tarjetas Amiibo; no es un producto oficial de Nintendo.</div>
  </div>
</div>
