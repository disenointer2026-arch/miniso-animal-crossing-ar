<!-- Bienvenida. En el navegador el boton entra a la realidad aumentada; dentro del visor inicia la experiencia. -->
<style>
  .panel-root { flex-direction: column; width: 480px; font-family: nunito; background-color: #FAF6D4; border-radius: 28px; border-width: 4px; border-color: #FDD885; }
  .panel-content { flex-direction: column; align-items: center; gap: 6px; padding: 28px; }
  .brand { color: #E60012; font-size: 38px; font-weight: 700; letter-spacing: 3px; }
  .cross { color: #2F5D46; font-size: 20px; font-weight: 700; }
  .collab { color: #2F5D46; font-size: 30px; font-weight: 700; }
  .body { color: #3A2E28; font-size: 20px; line-height: 1.3; text-align: center; margin-top: 8px; }
  .button { justify-content: center; margin-left: 28px; margin-right: 28px; margin-bottom: 28px; background-color: #FF0000; border-radius: 40px; color: #ffffff; font-weight: 700; text-align: center; cursor: pointer; }
  .panel-root:dark { background-color: #FAF6D4; border-color: #FDD885; }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div class="brand">MINISO</div>
    <div class="cross">x</div>
    <div class="collab">Animal Crossing</div>
    <div class="body">Crea tu personaje con tus propias manos</div>
  </div>
  <Button id="start-button" class="button">
    <ButtonLabel id="start-label">Entrar en RA</ButtonLabel>
  </Button>
</Panel>
